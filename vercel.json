{
  "redirects": [
    {
      "source": "/luopos",
      "destination": "/luopos/",
      "permanent": true
    },
    {
      "source": "/herramientas",
      "destination": "/herramientas/index.html",
      "permanent": true
    },
    {
      "source": "/herramientas/",
      "destination": "/herramientas/index.html",
      "permanent": true
    },
    {
      "source": "/quiz",
      "destination": "/quiz.html",
      "permanent": true
    },
    {
      "source": "/quiz/",
      "destination": "/quiz.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/herramientas/:path*",
      "destination": "https://aleran-piano.vercel.app/:path*"
    },
    {
      "source": "/luopos/:path*",
      "destination": "https://luopos.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/((?!herramientas).*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/herramientas/:path*",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|ico|mp3|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
